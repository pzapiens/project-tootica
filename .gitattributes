# Normalize line endings to LF on commit — keeps Prettier (endOfLine: lf) happy
# and avoids CRLF/LF churn when teammates commit from different OSes.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
