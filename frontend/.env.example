# Origin of the backend API. Used by next.config.ts to proxy /api/* requests.
# In production, point this at the deployed backend URL.
BACKEND_ORIGIN=http://localhost:4000

# Base for WhatsApp click-to-chat links (the Chat action on the appointments
# page). Defaults to the public wa.me endpoint; override to point at a branded
# short link. When the Meta WhatsApp Cloud API integration lands, the link
# building is swapped in src/lib/whatsapp.ts (this stays the fallback).
NEXT_PUBLIC_WHATSAPP_LINK_BASE=https://wa.me
