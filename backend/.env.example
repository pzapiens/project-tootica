# Server
NODE_ENV=development
PORT=4000

# CORS — comma-separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:3000

# Database — matches docker-compose.yml credentials
DATABASE_URL=postgresql://tootica:tootica_dev_password@localhost:5432/tootica

# SMTP — MailHog (see docker-compose.yml). No auth in local dev.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tootica <no-reply@tootica.local>
# Emails are viewable at http://localhost:8025

# JWT — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit real secrets; each environment should have its own.
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACTION_SECRET=replace-me-action

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=600
INVITE_TOKEN_TTL_SECONDS=604800

# OTP policy
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
