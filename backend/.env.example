# Server
NODE_ENV=development
PORT=4000

# CORS — comma-separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:3000

# Database — matches docker-compose.yml credentials
DATABASE_URL=postgresql://tootica:tootica_dev_password@localhost:5432/tootica

# SMTP — local dev uses MailHog (see docker-compose.yml); no auth.
# Emails (new-account temp passwords + forgot-password OTP) are viewable at
# http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tootica <no-reply@tootica.local>
#
# Production: point at a real SMTP provider (Brevo recommended). Use port 587
# (STARTTLS — the transport sets secure:false) and a sender on a domain you've
# verified with SPF + DKIM. Example (Brevo):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<brevo-login>
#   SMTP_PASSWORD=<brevo-smtp-key>
#   MAIL_FROM=Tootica <no-reply@yourdomain.com>

# JWT — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit real secrets; each environment should have its own.
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACTION_SECRET=replace-me-action

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=600
INVITE_TOKEN_TTL_SECONDS=604800

# OTP policy (shared by password-reset and login codes)
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5

# SMS (login OTP). Leave everything blank in dev — the code is logged to the
# server console ([sms:console]). Provider is auto-selected: MSG91 → Twilio →
# console (first one whose vars are fully set wins).
#
# MSG91 (recommended for India — DLT template-based, cheap domestic rates).
# Register a DLT-approved template under MSG91's OTP section; it's sent via the
# OTP API, which fills the reserved ##OTP## variable, e.g.
#   "Your Tootica login code is ##OTP##. It expires in 5 minutes. ..."
# (The app generates/verifies the code; otp_expiry is set from OTP_TTL_SECONDS.)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
#
# Twilio (global fallback). Set all three to send via Twilio instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Patient-document uploads. Bytes are written to this local directory (relative
# to the backend's working dir), metadata to the DB. Swap for object storage
# (S3) later behind the storage module.
UPLOAD_DIR=uploads

# WhatsApp Phase 1. Generate a 32-byte hex key; back it up securely.
# Never rotate this without re-provisioning/re-encrypting existing connections.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_GRAPH_VERSION=v23.0
# One-time provisioning only; remove these after provisioning.
WHATSAPP_PROVISION_CLINIC_ID=
WHATSAPP_PROVISION_WABA_ID=
WHATSAPP_PROVISION_PHONE_NUMBER_ID=
WHATSAPP_PROVISION_ACCESS_TOKEN=
WHATSAPP_PROVISION_TEMPLATE_NAME=
WHATSAPP_PROVISION_TEMPLATE_LANGUAGE=en_US
