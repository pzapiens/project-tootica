// Tootica — Prisma schema
// Multi-tenant dental management system. Every tenant-scoped table carries a
// `clinic_id` and has a compound index leading with it so per-clinic queries
// stay index-covered.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
  // passed to the PrismaClient constructor via a driver adapter at runtime.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  CLIENT_ADMIN
  DOCTOR
  RECEPTIONIST
  GUEST_DOCTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ClinicPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
  NO_SHOW
}

// How an appointment entered the system. `WEB` = created by clinic staff in the
// app; `WHATSAPP` = booked by the patient over WhatsApp (arrives SCHEDULED with
// no doctor/time, surfaced in the "WhatsApp Appointments" popup). This is the
// durable channel marker — it survives accept/reject (which only change status),
// unlike `sourceOfEnquiry` (an editable lead-source). The inbound WhatsApp
// webhook stamps `WHATSAPP`; the real Meta Cloud API integration will reuse it.
enum BookingChannel {
  WEB
  WHATSAPP
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Named monotonic counters that back the clinic-prefixed display codes. Child
/// codes are sequenced PER CLINIC, so each `name` is scoped by clinic id — e.g.
/// "branch:<clinicId>", "doctor:<clinicId>", "patient:<clinicId>",
/// "appointment:<clinicId>" — holding the last-issued sequence for that clinic.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

/// A tenant. Each clinic owns its own users, doctors, patients and appointments.
model Clinic {
  id        String       @id @default(uuid()) @db.Uuid
  // Human-friendly code, assigned by the super admin on creation (e.g. "TDG001").
  // All child codes are derived from it (e.g. "TDG001-B001", "TDG001-P000001").
  code      String?      @unique @map("clinic_code")
  name      String
  status    ClinicStatus @default(ACTIVE)
  plan      ClinicPlan   @default(FREE)
  createdAt DateTime     @default(now()) @map("created_at")

  users          User[]
  doctors        Doctor[]
  patients       Patient[]
  appointments   Appointment[]
  doctorShifts   DoctorShift[]
  doctorBlocks   DoctorBlock[]
  branches       Branch[]
  toothRemarks   ToothRemark[]
  medicalHistory MedicalHistoryEntry[]
  observations   ObservationEntry[]
  documents      PatientDocument[]
  recordAuditLogs RecordAuditLog[]

  @@map("clinics")
}

/// A physical branch / location under a Clinic. The clinic-selection screen
/// lists these; each may have a person-in-charge (PIC) user.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  // Clinic-prefixed code, e.g. "TDG001-B001" (per-clinic branch sequence).
  code      String   @unique @map("branch_code")
  name      String
  // A branch's person-in-charge can be a linked user (picUserId) OR free-text
  // (picName/contact) captured when the branch is created via the admin form.
  picUserId String?  @map("pic_user_id") @db.Uuid
  picName   String?  @map("pic_name")
  contact   String?
  createdAt DateTime @default(now()) @map("created_at")

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  pic     User?    @relation("BranchPIC", fields: [picUserId], references: [id])
  // Staff (doctors + receptionists) assigned to this specific branch. A clinic
  // admin is NOT branch-scoped (branchId null) — they access every branch.
  staff   User[]   @relation("BranchStaff")
  doctors Doctor[] @relation("BranchDoctors")

  @@index([clinicId, id])
  @@map("branches")
}

/// Authentication + authorization principal. `clinicId` is nullable so a
/// SUPER_ADMIN can exist outside any single clinic. Profile data for doctors
/// lives on the separate `doctors` table.
model User {
  id                String     @id @default(uuid()) @db.Uuid
  clinicId          String?    @map("clinic_id") @db.Uuid
  // The branch a DOCTOR / RECEPTIONIST is assigned to. Null for CLIENT_ADMIN
  // (clinic-wide access) and SUPER_ADMIN (no clinic).
  branchId          String?    @map("branch_id") @db.Uuid
  email             String     @unique
  // Optional honorific (e.g. "Mr", "Mrs", "Ms"). Doctors are addressed as "Dr"
  // from their role, so this is mainly for non-doctor staff.
  title             String?    @map("title")
  // Optional display name. Populated at onboarding; used for greetings / PIC.
  firstName         String?    @map("first_name")
  lastName          String?    @map("last_name")
  // Optional contact number for the user (e.g. a PIC's phone on the branch list).
  // Unique when present (Postgres allows many NULLs) so it can serve as a login
  // identifier for the phone + OTP sign-in flow. Stored normalized (E.164-ish).
  phone             String?    @unique @map("phone")
  // Nullable: invite-onboarded users (Client Admins, Doctors) exist before they
  // set a password via the /auth/set-password invite link.
  passwordHash      String?    @map("password_hash")
  role              Role
  status            UserStatus @default(ACTIVE)
  // True until the user completes the forced first-login reset (set a new
  // password + accept the Terms & Conditions). New accounts start with a
  // temporary password and this flag set; the client shows the reset prompt
  // while it's true.
  mustResetPassword Boolean    @default(true) @map("must_reset_password")
  // When the user accepted the Terms & Conditions / Privacy Policy (null until
  // they do). Set during the first-login reset.
  termsAcceptedAt   DateTime?  @map("terms_accepted_at")
  accessStartDate   DateTime?  @map("access_start_date")
  accessEndDate     DateTime?  @map("access_end_date")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  clinic           Clinic?  @relation(fields: [clinicId], references: [id])
  branch           Branch?  @relation("BranchStaff", fields: [branchId], references: [id])
  doctor           Doctor?
  branchesInCharge Branch[] @relation("BranchPIC")

  @@index([clinicId, id])
  @@index([clinicId, createdAt])
  @@index([branchId])
  @@map("users")
}

/// Doctor profile, one-to-one with a User (the auth record). Kept separate from
/// `users` so profile fields don't bloat the auth table.
model Doctor {
  id             String   @id @default(uuid()) @db.Uuid
  // Clinic-prefixed code, e.g. "TDG001-D001" (per-clinic doctor sequence).
  code           String?  @unique @map("doctor_code")
  userId         String   @unique @map("user_id") @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  // Branch this doctor works at (mirrors the linked user's branchId).
  branchId       String?  @map("branch_id") @db.Uuid
  specialization String?
  licenseNumber  String?  @map("license_number")
  phone          String?
  bio            String?
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  branch       Branch?       @relation("BranchDoctors", fields: [branchId], references: [id])
  shifts       DoctorShift[]
  blocks       DoctorBlock[]
  appointments Appointment[]

  @@index([clinicId, id])
  @@index([branchId])
  @@map("doctors")
}

/// A doctor's shift, as captured in the "Edit Doctor Shift" screen: a picked
/// start `date` plus a `frequency` describing how it repeats forward from there
/// (Day | Weekly | Biweekly | Monthly | Yearly | Every day), and a time window.
/// Dates added together in one action share a `groupId` (one editor row). Times
/// are "HH:mm" 24h strings; `date` is date-only, in the clinic's local time.
model DoctorShift {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  groupId   String?  @map("group_id")
  frequency String
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, id])
  @@index([doctorId])
  @@map("doctor_shifts")
}

/// A time range on a specific `date` a doctor has marked as Blocked (unavailable
/// for booking) from the Doctor Availability popup. Times are "HH:mm" 24h.
model DoctorBlock {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, id])
  @@index([doctorId])
  @@map("doctor_blocks")
}

/// A patient record, scoped to a single clinic.
model Patient {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @map("clinic_id") @db.Uuid
  // Clinic-prefixed code, e.g. "TDG001-P000001" (per-clinic patient sequence).
  code         String?   @unique @map("patient_code")
  name         String
  phone        String?
  email        String?
  // Optional; captured on the "New Patient Profile" form (e.g. "M" / "F").
  gender       String?
  dob          DateTime? @db.Date
  medicalNotes String?   @map("medical_notes")
  createdAt    DateTime  @default(now()) @map("created_at")

  clinic         Clinic                @relation(fields: [clinicId], references: [id])
  appointments   Appointment[]
  toothRemarks   ToothRemark[]
  medicalHistory MedicalHistoryEntry[]
  observations   ObservationEntry[]
  documents      PatientDocument[]
  recordAuditLogs RecordAuditLog[]

  @@index([clinicId, id])
  @@index([clinicId, createdAt])
  @@map("patients")
}

/// A booked appointment linking a patient and a doctor within a clinic.
model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  // Clinic-prefixed code, e.g. "TDG001-A000001" (per-clinic appointment seq).
  // Null for a pending WhatsApp booking until it's accepted — the code is
  // claimed on accept, so rejected requests never burn a sequence number.
  code             String?           @unique @map("appointment_code")
  clinicId         String            @map("clinic_id") @db.Uuid
  // Optional: a pending WhatsApp booking from a NEW lead has no patient yet — the
  // patient is created only when staff accept it (so a rejected request never
  // creates one). Until then the lead's details live in the `contact*` fields.
  patientId        String?           @map("patient_id") @db.Uuid
  // Optional: WhatsApp bookings arrive with no doctor assigned, and the
  // date-&-time flow lets staff create/edit an appointment without one.
  doctorId         String?           @map("doctor_id") @db.Uuid
  startTime        DateTime          @map("start_time")
  endTime          DateTime          @map("end_time")
  status           AppointmentStatus @default(SCHEDULED)
  // How the booking came in — WEB (staff-created) or WHATSAPP (patient booked
  // over WhatsApp). Durable across accept/reject; see the enum's doc comment.
  bookingChannel   BookingChannel    @default(WEB) @map("booking_channel")
  // Structured consultation type (e.g. "Teeth Whitening"); free-text `notes`
  // holds any additional message.
  consultationType String?           @map("consultation_type")
  // Where the enquiry came from (e.g. "Google Search", "Referral").
  sourceOfEnquiry  String?           @map("source_of_enquiry")
  // Prospective patient's details for a pending WhatsApp lead with no patient
  // row yet (unused once a patient is linked, i.e. on accept or when the number
  // already matched an existing patient).
  contactName      String?           @map("contact_name")
  contactPhone     String?           @map("contact_phone")
  contactEmail     String?           @map("contact_email")
  // A WhatsApp lead can also carry age/gender (no doctor is ever assigned over
  // WhatsApp). Stored here until the patient row is created on accept.
  contactGender    String?           @map("contact_gender")
  contactDob       DateTime?         @map("contact_dob") @db.Date
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  patient  Patient?  @relation(fields: [patientId], references: [id])
  doctor   Doctor?   @relation(fields: [doctorId], references: [id])
  payments Payment[]

  @@index([clinicId, id])
  @@index([clinicId, startTime])
  @@index([doctorId, startTime])
  @@index([patientId])
  @@map("appointments")
}

/// A single payment/charge entry against an appointment (Payment Management
/// dialog). An appointment can have several, each individually marked paid /
/// unpaid; the appointment reads as "settled" once every entry is paid. Scoped
/// to its clinic through the appointment.
model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  description   String
  // Money, two decimals (e.g. 1500.00). Serialised to a JS number for the client.
  amount        Decimal  @db.Decimal(12, 2)
  // Whether this entry has been paid (per-entry checkbox in the dialog).
  paid          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("payments")
}

/// A per-tooth remark from the Patient Records "Perio-dental chart": an FDI tooth
/// number plus free-text. Multiple remarks per tooth are allowed.
model ToothRemark {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  toothNo   String   @map("tooth_no")
  remarks   String
  // The user who created the row — only they may edit/delete it. Name is
  // denormalized (for display / to survive account deletion). Null for legacy
  // rows created before this was tracked (those stay editable by anyone).
  createdById   String?  @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@map("tooth_remarks")
}

/// A dated entry in a patient's medical history (Patient Records screen).
model MedicalHistoryEntry {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  text      String
  // Creator — only they may edit/delete (null for legacy rows). See ToothRemark.
  createdById   String?  @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name")
  createdAt DateTime @default(now()) @map("created_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@map("medical_history_entries")
}

/// A dated Doctor/Clinic observation entry (Patient Records screen). Mirrors
/// MedicalHistoryEntry: multiple free-text observations per patient, each dated.
model ObservationEntry {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  text      String
  // Creator — only they may edit/delete (null for legacy rows). See ToothRemark.
  createdById   String?  @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name")
  createdAt DateTime @default(now()) @map("created_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@map("observation_entries")
}

/// An uploaded patient document (consent form / x-ray / other). Only metadata
/// lives here; the file bytes are held by the file-storage module (local disk
/// for now) under `storageKey`.
model PatientDocument {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @map("clinic_id") @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  // One of: "consent" | "xray" | "other" (the upload sections on the screen).
  category   String
  name       String
  size       Int
  mimeType   String   @map("mime_type")
  storageKey String   @map("storage_key")
  // The uploader — shown on the document card. Denormalized name (survives
  // account deletion); null for legacy uploads. See ToothRemark.
  createdById   String?  @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name")
  createdAt  DateTime @default(now()) @map("created_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@map("patient_documents")
}

/// An audit-log entry for edits/deletes to a patient's records tables
/// (observations, tooth remarks, medical history). Surfaced to admins on the
/// Patient Records screen so they can see who changed what and when. The acting
/// user's name is denormalized so the log survives that account's deletion.
model RecordAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  // Which records table: "observation" | "tooth" | "medical-history".
  table     String
  // "UPDATE" | "DELETE".
  action    String
  // The affected entry's id (informational — the entry may no longer exist).
  entryId   String   @map("entry_id")
  // Human-readable snapshots of the row before/after the change. `previous` is
  // null on a create, `updated` is null on a delete.
  previous  String?
  updated   String?
  // The acting user — denormalized name so it survives the account's deletion.
  userId    String   @map("user_id") @db.Uuid
  userName  String   @map("user_name")
  createdAt DateTime @default(now()) @map("created_at")

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, createdAt])
  @@map("record_audit_logs")
}
