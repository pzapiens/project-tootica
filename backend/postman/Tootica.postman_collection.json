{
  "info": {
    "_postman_id": "b3a7f1e2-4c8d-4e2a-9f10-7a1c2d3e4f50",
    "name": "Tootica API",
    "description": "Tootica dental management backend. Auth is cookie-based (httpOnly access + refresh cookies) — Postman's cookie jar stores them automatically, so run **Auth → Login** first and subsequent requests reuse the session.\n\nPrereqs: `docker compose up -d`, `npm run db:migrate:deploy`, `npm run db:seed`, `npm run dev`.\n\nSeeded logins:\n- SUPER_ADMIN: super@tootica.local / SuperSecret123!\n- CLIENT_ADMIN: admin@tootica.local / Password123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "mailhogUrl", "value": "http://localhost:8025" },
    { "key": "adminEmail", "value": "admin@tootica.local" },
    { "key": "adminPassword", "value": "Password123!" },
    { "key": "superEmail", "value": "super@tootica.local" },
    { "key": "superPassword", "value": "SuperSecret123!" },
    { "key": "otp", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "inviteToken", "value": "" },
    { "key": "clinicId", "value": "" },
    { "key": "patientId", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "doctorUserId", "value": "" },
    { "key": "appointmentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Client Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('returns user', () => pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('adminEmail')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Sets access_token + refresh_token cookies. Run this before the tenant-scoped requests."
          }
        },
        {
          "name": "Login (Super Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superEmail}}\",\n  \"password\": \"{{superPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Switches the session to the super admin. Run before the Super Admin folder requests."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Rotates the access + refresh cookies using the refresh cookie."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Requires an active session. The example keeps the same password so the seeded login keeps working — change newPassword to actually rotate it."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Emails a 6-digit OTP to MailHog. Then run 'Fetch latest OTP (MailHog)'."
          }
        },
        {
          "name": "Fetch latest OTP (MailHog)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "const body = (data.items && data.items[0] && data.items[0].Content.Body) || '';",
                  "const m = body.match(/(\\d{6})/);",
                  "if (m) {",
                  "  pm.collectionVariables.set('otp', m[1]);",
                  "  console.log('Captured OTP:', m[1]);",
                  "} else {",
                  "  console.warn('No OTP found — did you run Forgot Password?');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{mailhogUrl}}/api/v2/messages",
              "host": ["{{mailhogUrl}}"],
              "path": ["api", "v2", "messages"]
            },
            "description": "Reads the newest MailHog message and stores its 6-digit code in the `otp` variable."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.resetToken) {",
                  "  pm.collectionVariables.set('resetToken', j.resetToken);",
                  "  console.log('Captured resetToken');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"code\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            },
            "description": "Validates the OTP and returns a short-lived reset token (captured into `resetToken`)."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Resets the password. The example sets it back to adminPassword so the seeded login keeps working."
          }
        },
        {
          "name": "Set Password (invite)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\",\n  \"password\": \"DoctorPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/set-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "set-password"]
            },
            "description": "First-time password setup for an invited (passwordless) user. Onboarding that mints invite tokens is not built yet; until then, generate one for an existing passwordless user id and set the `inviteToken` variable:\n\n  npx tsx -e \"import {signActionToken} from './src/modules/auth/jwt.util'; console.log(signActionToken('<USER_ID>','invite'))\""
          }
        }
      ]
    },
    {
      "name": "Super Admin",
      "description": "Run 'Auth → Login (Super Admin)' first. SUPER_ADMIN only; not clinic-scoped.",
      "item": [
        {
          "name": "List Clinics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/clinics",
