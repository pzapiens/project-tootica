        {
          "name": "Get Clinic",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/clinics/{{clinicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "clinics", "{{clinicId}}"]
            }
          }
        },
        {
          "name": "Update Clinic",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"plan\": \"PRO\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/clinics/{{clinicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "clinics", "{{clinicId}}"]
            }
          }
        },
        {
          "name": "Delete Clinic",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/super-admin/clinics/{{clinicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "super-admin", "clinics", "{{clinicId}}"]
            }
          }
        }
      ]
    },
