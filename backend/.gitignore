# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Prisma — generated client is regenerated by `prisma generate` (postinstall).
# Migrations and schema ARE committed (do not ignore prisma/migrations).
/src/generated/

# Environment & secrets — never commit real secrets. Only .env.example is shared.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Test / coverage output
coverage/
.nyc_output/

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# OS
.DS_Store
Thumbs.db
Desktop.ini

# AI-assistant tooling (scaffolding added by `prisma init`; not needed to run the app)
.claude/settings.local.json
.agents/
.windsurf/
skills-lock.json
